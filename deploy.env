#
# The settings of deploy.sh, and the environment of a host it has deployed to. deploy.sh leaves
# a copy in DEPLOY_ROOT. Source that copy on the host before running anything there, so that
# pixi and CUDA keep their files under DEPLOY_ROOT and write nothing to the home directory:
#
#   source /tmp/$USER/tango-ucx/deploy.env

# Everything is put here: pixi, its cache, the CUDA caches and the clones. It is read on each
# host, so the user's name is the one there.
DEPLOY_ROOT=/tmp/$(id -un)/tango-ucx

# The hosts deploy.sh goes to when none is named, as ssh names them: "node1 node2".
DEPLOY_HOSTS=""

# Whether the GPU programs are built: yes, no, or auto, which is yes where nvidia-smi lists a GPU.
DEPLOY_GPU=auto

# The release of pixi to install: latest, or a version such as 0.59.0.
DEPLOY_PIXI_VERSION=latest

# Each project: where it is cloned from, and the branch, tag or commit that is built. A
# repository may be a directory on the host deploy.sh is started on; it is carried to the other
# hosts as a git bundle, with what is committed in it and nothing else.
TANGO_UCX_REPO=https://github.com/srwohl/tango-ucx
TANGO_UCX_REF=master

# Empty is the repository deploy.sh is in.
BENCHMARKS_REPO=""
BENCHMARKS_REF=master

# Built only where there is a GPU. Empty leaves the project out.
GPU_EXAMPLES_REPO=https://github.com/srwohl/tango-ucx-gpu-examples
GPU_EXAMPLES_REF=master

# The environment. PIXI_HOME has the pixi binary in bin/; the environments of each project are
# in its clone, and so under DEPLOY_ROOT too.
export DEPLOY_ROOT
export PIXI_HOME=$DEPLOY_ROOT/pixi
export PIXI_CACHE_DIR=$DEPLOY_ROOT/cache/pixi
# The kernels the CUDA driver and CuPy compile: ~/.nv and ~/.cupy otherwise.
export CUDA_CACHE_PATH=$DEPLOY_ROOT/cache/cuda
export CUPY_CACHE_DIR=$DEPLOY_ROOT/cache/cupy
# Whatever else keeps a cache, as matplotlib does in the examples.
export XDG_CACHE_HOME=$DEPLOY_ROOT/cache
# The library the benchmarks and the examples are built against.
export TANGO_UCX_SOURCE=$DEPLOY_ROOT/tango-ucx
case ":$PATH:" in
    *":$PIXI_HOME/bin:"*) ;;
    *) export PATH=$PIXI_HOME/bin:$PATH ;;
esac
